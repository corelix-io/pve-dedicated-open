# pve-dedicated -- Default Configuration
# Loaded on every run as *defaults*: values from --config FILE and CLI
# arguments override them, and interactive mode still prompts for system
# identity (hostname, FQDN, timezone, email) unless you set those yourself.
#
# Copy this file and customize it for your deployment. Syntax: KEY=value,
# KEY="value" or KEY='value'; "# comments" are allowed after unquoted and
# quoted values. The file is parsed, never executed.

# --- Provider ---
# Auto-detected from the rescue environment when blank. Valid: hetzner | ovh
# PVE_PROVIDER=""

# --- System ---
PVE_HOSTNAME="proxmox"
PVE_FQDN="proxmox.example.com"   # must start with PVE_HOSTNAME
PVE_TIMEZONE="UTC"
PVE_EMAIL="admin@example.com"
# PVE_ROOT_PASSWORD=""           # min. 8 chars; set via CLI, config file or prompt
                                 # (written to answer.toml as a SHA-512 hash)

# --- SSH Security ---
# SSH public keys for root access. When set, password login is disabled
# and SSH is hardened (PermitRootLogin prohibit-password, key-only auth).
# Multiple keys: one per line inside the quotes, or space-separated.
# In interactive mode, keys are auto-detected from the rescue system.
# PVE_SSH_KEYS="ssh-ed25519 AAAA... user@host"

# --- Keyboard / Locale ---
PVE_KEYBOARD="en-us"
PVE_COUNTRY="us"

# --- Disk ---
PVE_DISK_MODE="auto"             # auto = all detected non-USB disks, manual = interactive
# PVE_DISKS=""                   # Comma-separated: nvme0n1,nvme1n1
PVE_FILESYSTEM="zfs"             # zfs, ext4, xfs, btrfs
PVE_ZFS_RAID="raid1"             # raid0, raid1, raid10, raidz-1, raidz-2, raidz-3
PVE_ZFS_COMPRESS="lz4"           # on, off, lz4, zstd, gzip, lzjb, zle
# PVE_ZFS_ASHIFT=""              # 9-16; installer default is 12 (4K sectors)
# PVE_ZFS_ARC_MAX=""             # Max ARC memory in MiB (default: 15% of RAM)

# --- Network ---
# PVE_INTERFACE=""               # Auto-detected if empty (rescue-side name)
PVE_NETWORK_MODE="nat"           # nat, routed, bridged
PVE_PRIVATE_SUBNET="192.168.26.0/24"  # NAT bridge vmbr1 (nat mode only)
PVE_ENABLE_DHCP=true             # dnsmasq DHCP on vmbr1, hands out .100-.200
# PVE_ADDITIONAL_IPS=""          # routed mode: IPs routed onto vmbr0, e.g. "203.0.113.10,203.0.113.11"
# PVE_DNS_SERVERS=""             # Provider default applied if empty:
                                 #   hetzner -> 185.12.64.1 185.12.64.2
                                 #   ovh     -> 213.186.33.99 1.1.1.1

# --- OVH-specific (only used when PVE_PROVIDER=ovh) ---
# PVE_OVH_GATEWAY_MODEL="auto"   # auto | classic | scale
# PVE_OVH_VRACK_INTERFACE=""     # Second NIC for vRack bridge (vmbr2)
# PVE_OVH_VRACK_IP_CIDR=""       # Static IP/CIDR on vRack bridge
# PVE_OVH_IPV6_GATEWAY=""        # From the Control Panel; default: detected/derived

# --- Premium: host-level LUKS (only honored in premium build) ---
# PVE_FEATURE_LUKS=false
# PVE_LUKS_PASSPHRASE=""
# PVE_LUKS_UNLOCK_MODES="passphrase"   # csv: passphrase,ssh,tpm
# PVE_LUKS_DROPBEAR_PORT="2222"
# PVE_LUKS_WAN_MAC=""

# --- Boot ---
PVE_BOOT_MODE="auto"             # auto, uefi, legacy

# --- ISO ---
# PVE_ISO_PATH=""                # Use a local ISO instead of downloading
# PVE_ISO_VERSION=""             # Pin: "9", "9.2" or "9.2-1" (default: latest)
# PVE_ISO_VERIFY=true            # SHA-256 check against Proxmox's SHA256SUMS

# --- Debian Suite ---
# PVE_DEBIAN_SUITE=""            # Default: derived from the ISO (9.x -> trixie)

# --- Logging ---
PVE_LOG_LEVEL=1                  # 0=DEBUG, 1=INFO, 2=WARN, 3=ERROR
